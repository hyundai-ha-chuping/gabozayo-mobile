<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash_bg">#F7F5EE</color>

    <!-- 앱 본 화면 테마 -->
    <style name="Theme.Gabozayo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- 시작 화면(밴 + 가보자요): 앱이 뜨는 동안 이 화면 하나만 보여요 -->
    <style name="Theme.Gabozayo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Gabozayo</item>
    </style>
</resources>
